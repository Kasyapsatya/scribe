# Copy to secrets.toml (same folder) for local runs, or paste into the app's Secrets box on Streamlit Community Cloud.
# secrets.toml is git-ignored — never commit it. Nothing here is shown on the UI.

GOOGLE_API_KEY = "paste-your-gemini-key-here"   # team key: used when a teammate has not entered their own under ⚙

# Optional
# SHOW_KEY_SETTINGS = false      # hide the ⚙ "use your own Gemini key" box
# GEMINI_RPM = 5                 # requests per minute allowed per key (free tier: 5)
# SCRIBE_MODEL = ""              # pin a model; leave out to auto-pick the newest stable Flash model with tool calling

# Keep every chat in the team's GitHub repo automatically (saved after each reply; the Chats list shows the team's chats and
# survives app restarts). Without these, chats stay on the server only and reset when the hosted app restarts.
# GITHUB_TOKEN = "github_pat_..." # fine-grained token: this repository only, permission Contents = Read and write
# GITHUB_REPO = "owner/repo"
# GITHUB_BRANCH = "chats"        # created automatically; a separate branch so saving chats never redeploys the app
